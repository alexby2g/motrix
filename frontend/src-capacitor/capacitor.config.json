{
  "appId": "bo.edu.josecastillo.motrix",
  "appName": "MOTRIX",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
