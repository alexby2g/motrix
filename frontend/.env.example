# API Laravel local. En Vercel reemplazar por la URL HTTPS de Render.
VITE_API_URL=http://127.0.0.1:8000/api

# Laravel Reverb local. En producción usar el host HTTPS/WSS del servicio Reverb.
VITE_REVERB_APP_KEY=motrix-local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
