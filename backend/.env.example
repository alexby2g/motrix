APP_NAME=MOTRIX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desarrollo local con Laragon / MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motrix_integrado
DB_USERNAME=root
DB_PASSWORD=

# Producción con Neon: usar PostgreSQL y pegar la cadena completa en DB_URL.
# DB_CONNECTION=pgsql
# DB_URL=postgresql://usuario:password@host.neon.tech/base?sslmode=require
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Web/PWA/Android autorizados para consumir la API, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000,capacitor://localhost
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=motrix
REVERB_APP_KEY=motrix-local-key
REVERB_APP_SECRET=motrix-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@motrix.local"
MAIL_FROM_NAME="${APP_NAME}"
