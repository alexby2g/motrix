APP_NAME=MOTRIX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.motrixbolivia.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motrix
DB_USERNAME=motrix_app
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Tokens Bearer: 43.200 min = 30 días. Ajustable según política final.
SANCTUM_EXPIRATION=43200

# Solo orígenes reales de MOTRIX. Nunca usar * en producción.
CORS_ALLOWED_ORIGINS=https://motrixbolivia.com,https://piloto.motrixbolivia.com,https://localhost,capacitor://localhost
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=motrix-production
REVERB_APP_KEY=motrix-pilot-key
REVERB_APP_SECRET=GENERAR_SECRETO_LARGO
REVERB_HOST=backend.motrixbolivia.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://motrixbolivia.com,https://piloto.motrixbolivia.com,https://localhost,capacitor://localhost
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

GOOGLE_CLIENT_ID=TU_CLIENT_ID_WEB.apps.googleusercontent.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@motrixbolivia.com
MAIL_FROM_NAME=MOTRIX

# URL del frontend usada para generar enlaces temporales de seguimiento.
FRONTEND_URL=https://piloto.motrixbolivia.com

# Recuperación por SMS: webhook opcional del proveedor. Si existe email real, se prioriza correo.
MOTRIX_SMS_WEBHOOK_URL=
MOTRIX_SMS_WEBHOOK_TOKEN=

# Firebase Cloud Messaging (HTTP v1). Usar credenciales reales; nunca versionar secretos.
MOTRIX_FIREBASE_CREDENTIALS=
MOTRIX_FIREBASE_PROJECT_ID=
MOTRIX_FIREBASE_CLIENT_EMAIL=
MOTRIX_FIREBASE_PRIVATE_KEY=
